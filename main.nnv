// Fib in my own Programming Language (*NNV)!
met fib(n: u64) -> u64 {
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }

    set a: u64 = 0;
    set b: u64 = 1;
    set c: u64;

    for i in 2..=n {
        c = a + b;
        a = b;
        b = c;
    }

    return b;
}


met main() {
    // Call 'Fib' with 12 n's
    set fib_series: u64 = fib(12);

    // Itoa fib_series
    set fib_itoaed = itoa(fib_series);

    // Put itoaed string to stdout
    puts(fib_itoaed);

    // Newline
    putchar('\n');
}
